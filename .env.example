# Copy this file to .env and add one or both direct-provider keys.
# thoughtcop tries Groq first and falls back to Cerebras when both are present.

GROQ_API_KEY=
CEREBRAS_API_KEY=

# Optional model overrides. These defaults are used when omitted.
GROQ_MODEL=qwen/qwen3.8-27b
# low | medium | high | omit — see CheckerReasoningEffort (Groq default: omit)
GROQ_REASONING_EFFORT=omit
CEREBRAS_MODEL=gpt-oss-120b

# Number of reasoning summaries loaded when thoughtcop starts or a session is pinned.
# Use an integer, 0 for no history, or "all" for the complete history.
THOUGHTCOP_HISTORY_COUNT=3
