# Copy this file to .env and add one or both direct-provider keys.
# thinkpeek tries Groq first and falls back to Cerebras when both are present.

GROQ_API_KEY=
CEREBRAS_API_KEY=

# Optional model overrides. These defaults are used when omitted.
GROQ_MODEL=llama-3.3-70b-versatile
CEREBRAS_MODEL=gpt-oss-120b

# Number of reasoning summaries loaded when thinkpeek starts or a session is pinned.
# Use an integer, 0 for no history, or "all" for the complete history.
THINKPEEK_HISTORY_COUNT=3

# Encrypted/signature-only reasoning is hidden by default. Set true to show it.
THINKPEEK_SHOW_ENCRYPTED=false
